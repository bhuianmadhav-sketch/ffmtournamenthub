<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solo Leveling Habit Tracker</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Rajdhani', sans-serif;
            background-color: #030712;
            color: #f3f4f6;
        }
        .font-orbitron {
            font-family: 'Orbitron', sans-serif;
        }
        .glow-violet {
            box-shadow: 0 0 20px rgba(139, 92, 246, 0.4);
        }
    </style>
</head>
<body class="min-h-screen bg-[#05050a] text-violet-100 flex flex-col items-center p-4 sm:p-6">

    <div class="max-w-4xl w-full mx-auto space-y-6">

        <!-- HEADER -->
        <header class="bg-gradient-to-r from-slate-900 via-purple-950 to-slate-900 border border-violet-500/40 rounded-2xl p-5 glow-violet flex flex-col md:flex-row justify-between items-center gap-4">
            <div>
                <div class="flex items-center gap-2">
                    <span class="px-2.5 py-0.5 bg-violet-600 text-white font-orbitron text-xs font-bold rounded">HUNTER</span>
                    <span id="hunter-rank" class="font-orbitron text-cyan-400 text-sm font-bold tracking-widest">E-RANK MONARCH</span>
                </div>
                <h1 class="font-orbitron text-2xl sm:text-3xl font-black text-white mt-1 tracking-wide">SHADOW MONARCH SYSTEM</h1>
            </div>
            
            <div class="flex items-center gap-3 bg-black/40 px-4 py-2.5 rounded-xl border border-violet-500/30">
                <div>
                    <div class="text-xs text-gray-400 font-orbitron">STREAK</div>
                    <div id="streak-count" class="text-xl font-black font-orbitron text-emerald-400">0 Days</div>
                </div>
            </div>
        </header>

        <!-- 21-DAY DISCIPLINE TRACKER GRID -->
        <section class="bg-slate-900/80 border border-violet-500/30 rounded-2xl p-5 backdrop-blur-md">
            <div class="flex justify-between items-center mb-4">
                <h3 class="font-orbitron font-bold text-violet-300 text-sm tracking-wider">21-DAY DISCIPLINE CHALLENGE (TAP DAY TO MARK)</h3>
                <button onclick="resetChallenge()" class="text-xs font-orbitron text-red-400 hover:text-red-300 underline">Reset</button>
            </div>
            <div id="days-grid" class="grid grid-cols-3 sm:grid-cols-7 gap-3"></div>
        </section>

        <!-- CUSTOM FOOD MACRO CALCULATOR -->
        <section class="bg-slate-900/80 border border-violet-500/30 rounded-2xl p-5 backdrop-blur-md">
            <h3 class="font-orbitron font-bold text-violet-300 text-sm tracking-wider mb-4">CUSTOM FOOD & MACRO CALCULATOR</h3>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-xs font-orbitron text-gray-400 mb-1">FOOD NAME</label>
                    <input type="text" id="custom-name" placeholder="e.g. Rice, Chicken, Dal..." class="w-full bg-black/60 border border-violet-500/40 rounded-xl p-2.5 text-sm text-white focus:outline-none focus:border-violet-400">
                </div>
                <div>
                    <label class="block text-xs font-orbitron text-gray-400 mb-1">QUANTITY (Grams / Bowls)</label>
                    <input type="number" id="custom-qty" value="100" class="w-full bg-black/60 border border-violet-500/40 rounded-xl p-2.5 text-sm text-white focus:outline-none focus:border-violet-400">
                </div>
                <div>
                    <label class="block text-xs font-orbitron text-gray-400 mb-1">CALORIES (per 100g/unit)</label>
                    <input type="number" id="custom-kcal" value="130" class="w-full bg-black/60 border border-violet-500/40 rounded-xl p-2.5 text-sm text-white focus:outline-none focus:border-violet-400">
                </div>
                <div>
                    <label class="block text-xs font-orbitron text-gray-400 mb-1">PROTEIN (g)</label>
                    <input type="number" id="custom-protein" value="5" class="w-full bg-black/60 border border-violet-500/40 rounded-xl p-2.5 text-sm text-white focus:outline-none focus:border-violet-400">
                </div>
            </div>
            <button onclick="addCustomFood()" class="w-full bg-violet-600 hover:bg-violet-500 text-white font-orbitron text-xs py-3 rounded-xl font-bold transition mb-4">ADD CUSTOM FOOD</button>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
                <div class="bg-black/50 p-3 rounded-xl border border-violet-900/50 text-center">
                    <span class="text-xs text-gray-400 font-orbitron">TOTAL CALORIES</span>
                    <div id="total-kcal" class="text-xl font-black font-orbitron text-amber-400 mt-1">0 kcal</div>
                </div>
                <div class="bg-black/50 p-3 rounded-xl border border-violet-900/50 text-center">
                    <span class="text-xs text-gray-400 font-orbitron">PROTEIN</span>
                    <div id="total-protein" class="text-xl font-black font-orbitron text-cyan-400 mt-1">0g</div>
                </div>
                <div class="bg-black/50 p-3 rounded-xl border border-violet-900/50 text-center">
                    <span class="text-xs text-gray-400 font-orbitron">CARBS</span>
                    <div id="total-carbs" class="text-xl font-black font-orbitron text-emerald-400 mt-1">0g</div>
                </div>
                <div class="bg-black/50 p-3 rounded-xl border border-violet-900/50 text-center">
                    <span class="text-xs text-gray-400 font-orbitron">FATS</span>
                    <div id="total-fat" class="text-xl font-black font-orbitron text-rose-400 mt-1">0g</div>
                </div>
            </div>

            <div class="flex justify-between items-center mb-2">
                <span class="text-xs font-orbitron text-gray-400">TODAY'S FOOD LOG</span>
                <button onclick="clearFoodLog()" class="text-xs text-red-400 hover:underline">Clear</button>
            </div>
            <div id="food-log-list" class="space-y-2 max-h-40 overflow-y-auto"></div>
        </section>

    </div>

    <script>
        let appData = JSON.parse(localStorage.getItem('solo_clean_data')) || {
            streakDays: Array(21).fill(false),
            foodLog: []
        };

        function initApp() {
            renderDaysGrid();
            renderFoodLog();
            updateStreakCount();
        }

        function saveState() {
            localStorage.setItem('solo_clean_data', JSON.stringify(appData));
        }

        function renderDaysGrid() {
            const grid = document.getElementById('days-grid');
            grid.innerHTML = '';
            appData.streakDays.forEach((marked, index) => {
                const btn = document.createElement('button');
                btn.className = `h-16 rounded-xl border flex flex-col items-center justify-center font-orbitron transition-all ${
                    marked ? 'bg-violet-950/85 border-violet-500 text-violet-200 glow-violet' : 'bg-black/40 border-violet-900/40 text-gray-500'
                }`;
                btn.innerHTML = `<span class="text-xs text-gray-400">DAY ${index + 1}</span><span class="text-lg font-bold">${marked ? '❌' : '·'}</span>`;
                btn.onclick = () => {
                    appData.streakDays[index] = !appData.streakDays[index];
                    saveState();
                    renderDaysGrid();
                    updateStreakCount();
                };
                grid.appendChild(btn);
            });
        }

        function updateStreakCount() {
            const completedCount = appData.streakDays.filter(Boolean).length;
            document.getElementById('streak-count').innerText = `${completedCount} Days`;
        }

        function resetChallenge() {
            if (confirm("Reset challenge?")) {
                appData.streakDays = Array(21).fill(false);
                saveState();
                initApp();
            }
        }

        function addCustomFood() {
            const name = document.getElementById('custom-name').value || "Custom Food";
            const qty = parseFloat(document.getElementById('custom-qty').value) || 100;
            const kcal = parseFloat(document.getElementById('custom-kcal').value) || 0;
            const protein = parseFloat(document.getElementById('custom-protein').value) || 0;

            const multiplier = qty / 100;
            const logItem = {
                name: `${qty}g ${name}`,
                kcal: Math.round(kcal * multiplier),
                protein: +(protein * multiplier).toFixed(1),
                carbs: 0,
                fat: 0
            };

            appData.foodLog.push(logItem);
            saveState();
            renderFoodLog();
        }

        function renderFoodLog() {
            const list = document.getElementById('food-log-list');
            list.innerHTML = '';
            let tKcal = 0, tProt = 0;

            appData.foodLog.forEach((log, idx) => {
                tKcal += log.kcal;
                tProt += log.protein;
                const row = document.createElement('div');
                row.className = 'bg-black/50 p-2.5 rounded-xl border border-violet-900/40 flex justify-between items-center text-sm';
                row.innerHTML = `<div><span class="text-white">${log.name}</span><div class="text-xs text-gray-400">${log.kcal} kcal | P: ${log.protein}g</div></div><button onclick="removeFood(${idx})" class="text-red-400 text-xs">Remove</button>`;
                list.appendChild(row);
            });

            document.getElementById('total-kcal').innerText = `${tKcal} kcal`;
            document.getElementById('total-protein').innerText = `${Math.round(tProt)}g`;
        }

        function removeFood(idx) {
            appData.foodLog.splice(idx, 1);
            saveState();
            renderFoodLog();
        }

        function clearFoodLog() {
            appData.foodLog = [];
            saveState();
            renderFoodLog();
        }

        initApp();
    </script>
</body>
</html>

